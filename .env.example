# Copie para .env e ajuste. NUNCA suba o .env para o GitHub.

# Banco de dados (no Docker Compose, o próprio compose já define a URL do serviço "db").
DATABASE_URL=postgresql+psycopg://h3:h3@localhost:5432/cotacoes

# Chave para assinar a sessão (JWT). Gere uma longa e aleatória:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Horas até a sessão expirar
JWT_EXPIRE_HOURS=12
# true em produção (HTTPS). Em http://localhost deixe false.
COOKIE_SECURE=false

# Leitura de cotações com IA (fica só no servidor, nunca vai para o navegador)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
IA_MAX_MB=20
# Preço (US$ por milhão de tokens) usado só na estimativa de custo do painel admin
IA_PRECO_ENTRADA_MTOK=2
IA_PRECO_SAIDA_MTOK=10

# Só necessário se o frontend ficar em outro domínio (separado por vírgula)
CORS_ORIGINS=
