# Copie para .env e ajuste. NUNCA suba o .env para o GitHub.

# Banco de dados (no Docker Compose, o próprio compose já define a URL do serviço "db").
DATABASE_URL=postgresql+psycopg://h3:h3@localhost:5432/cotacoes

# Chave para assinar a sessão (JWT). Gere uma longa e aleatória:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
# Horas até a sessão expirar
JWT_EXPIRE_HOURS=12
# true em produção (HTTPS). Em http://localhost deixe false.
COOKIE_SECURE=false

# Primeiro admin: criado automaticamente ao subir, só se o banco ainda não tiver nenhum usuário.
# (Alternativa: o comando "python -m app.cli criar-admin".) Depois de criado, pode apagar a senha daqui.
ADMIN_NOME=
ADMIN_EMAIL=
ADMIN_SENHA=
ADMIN_UNIDADE=Matriz

# Leitura com IA (as chaves ficam só no servidor, nunca vão para o navegador)
# Qual IA usar: gemini (Google, com camada gratuita) ou anthropic (Claude, pago por uso)
IA_PROVEDOR=gemini

# Google Gemini: crie a chave em https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Anthropic (Claude): só é usada se IA_PROVEDOR=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

IA_MAX_MB=20
# Preço (US$ por milhão de tokens) só para a estimativa de custo do painel admin.
# Deixe vazio para o padrão: 0 no Gemini gratuito; 2 e 10 no Claude Sonnet 5.5.
IA_PRECO_ENTRADA_MTOK=
IA_PRECO_SAIDA_MTOK=

# Só necessário se o frontend ficar em outro domínio (separado por vírgula)
CORS_ORIGINS=
